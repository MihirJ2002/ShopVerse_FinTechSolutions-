      <column caption='Total Transaction Value' datatype='real' name='[Calculation_0660831292375040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transaction_amount])' />
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_0660831294283777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue])' />
      </column>
      <column caption='Total Profit' datatype='real' name='[Calculation_0660831294427138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit])' />
      </column>
      <column caption='Unique Customers' datatype='integer' name='[Calculation_0660831294590979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id])' />
      </column>
      <column caption='Transaction Success Rate' datatype='real' name='[Calculation_0660831294758916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [transaction_status] = &quot;Success&quot; THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([transaction_id])' />
      </column>
      <column caption='Fraud Rate' datatype='real' default-format='p0.00%' name='[Calculation_0660831294902277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fraud_flag]) / COUNT([transaction_id])' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_0660831317860358]' role='measure' type='quantitative' visual-totals='Avg'>
        <calculation class='tableau' formula='SUM([profit]) / SUM([revenue])' />
      </column>
      <column caption='Profit Margin % ' datatype='real' name='[Calculation_1260065210281984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit]) / SUM([revenue])' />
      </column>
      <column caption='Market Share' datatype='real' name='[Calculation_1260065210544129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([market_share_percent])' />
      </column>
      <column caption='Customer Retention Rate' datatype='real' name='[Calculation_1260065210712066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 -SUM(INT([churn_flag]))/COUNT([transaction_id])' />
      </column>
      <column caption='High-Risk Transaction Rate' datatype='real' name='[Calculation_1260065211346947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [fraud_type] &lt;&gt; &quot;None&quot; THEN 1 END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([transaction_id])' />
      </column>
